# LSA SAF Data Access Service credentials
# Create a .env (NOT committed) at repo root:
#   cp .env.example .env
#   nano .env
USERNAME=your_username
PASSWORD=your_password

# Optional: default sample month for scripts/01_download_sample.sh
SAMPLE_YEAR=2010
SAMPLE_MONTH=01
VARIABLE_NAME=METREF
URL="https://datalsasaf.lsasvcs.ipma.pt/PRODUCTS/MSG/METREF/NETCDF"
